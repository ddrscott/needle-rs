{
 "name": "data_capture",
 "system": "Copy names, merchants, and descriptions verbatim from the user. Record only values the user stated; never estimate. Map each explicit supported record to exactly one declared call. Unsupported, incomplete, ambiguous, and negated requests return no call.",
 "tools": [
  {
   "name": "create_contact",
   "description": "Save a new contact. Copy the name word for word and the number digit for digit; never invent or complete them.",
   "parameters": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string",
      "description": "Full name of the contact, copied word for word.",
      "minLength": 1,
      "maxLength": 60
     },
     "phone": {
      "type": "string",
      "description": "The phone number exactly as given; include only when stated.",
      "pattern": "^\\+?[0-9][0-9 -]{5,17}$"
     },
     "email": {
      "type": "string",
      "description": "The email address; include only when stated.",
      "format": "email"
     }
    },
    "required": [
     "name"
    ]
   }
  },
  {
   "name": "log_expense",
   "description": "Record money spent. Log only amounts the user stated; never estimate.",
   "parameters": {
    "type": "object",
    "properties": {
     "amount": {
      "type": "number",
      "description": "The amount as stated, digits only.",
      "minimum": 0,
      "maximum": 100000
     },
     "category": {
      "type": "string",
      "enum": [
       "food",
       "groceries",
       "transport",
       "entertainment",
       "utilities",
       "shopping"
      ],
      "description": "The spending category the user named."
     },
     "merchant": {
      "type": "string",
      "description": "The store or vendor copied word for word; include only when named.",
      "minLength": 1,
      "maxLength": 60
     }
    },
    "required": [
     "amount",
     "category"
    ]
   }
  },
  {
   "name": "log_meal",
   "description": "Log a meal or food item. Use log_expense for money spent on food.",
   "parameters": {
    "type": "object",
    "properties": {
     "description": {
      "type": "string",
      "description": "What was eaten, copied word for word.",
      "minLength": 1,
      "maxLength": 120
     },
     "meal_type": {
      "type": "string",
      "enum": [
       "breakfast",
       "lunch",
       "dinner",
       "snack"
      ],
      "description": "Which meal; include only when stated."
     }
    },
    "required": [
     "description"
    ]
   }
  },
  {
   "name": "log_water_intake",
   "description": "Log water consumption in your water log.",
   "parameters": {
    "type": "object",
    "properties": {
     "amount_ml": {
      "type": "integer",
      "description": "Amount of water in milliliters.",
      "minimum": 1,
      "maximum": 5000
     }
    },
    "required": [
     "amount_ml"
    ]
   }
  },
  {
   "name": "log_weight",
   "description": "Record a body-weight measurement in kilograms.",
   "parameters": {
    "type": "object",
    "properties": {
     "weight_kg": {
      "type": "number",
      "description": "The weight in kilograms as stated.",
      "minimum": 20,
      "maximum": 300
     }
    },
    "required": [
     "weight_kg"
    ]
   }
  }
 ],
