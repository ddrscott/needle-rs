{
 "name": "wearable",
 "system": "Copy reply text verbatim, preserving capitalization. Map each explicit supported watch action to exactly one declared call. Do not guess missing values. Unsupported, invalid, ambiguous, and negated requests return no call.",
 "tools": [
  {
   "name": "reply_to_notification",
   "description": "Reply to a message notification from a known sender. Copy the reply text word for word, preserving capitalization. Use dismiss_notification to clear one without replying.",
   "parameters": {
    "type": "object",
    "properties": {
     "notification_match": {
      "type": "string",
      "enum": [
       "Maya",
       "Leo",
       "Dr. Patel",
       "Cactus Team"
      ],
      "description": "Who the notification is from."
     },
     "text": {
      "type": "string",
      "description": "The reply message copied word for word.",
      "minLength": 1,
      "maxLength": 240
     }
    },
    "required": [
     "notification_match",
     "text"
    ]
   }
  },
  {
   "name": "dismiss_notification",
   "description": "Dismiss a sender's notification without replying.",
   "parameters": {
    "type": "object",
    "properties": {
     "notification_match": {
      "type": "string",
      "enum": [
       "Maya",
       "Leo",
       "Dr. Patel",
       "Cactus Team"
      ],
      "description": "Whose notification to dismiss."
     }
    },
    "required": [
     "notification_match"
    ]
   }
  },
  {
   "name": "start_workout",
   "description": "Start tracking a workout of an explicitly named type: running, walking, cycling, swimming, strength, or yoga. Use end_workout to finish one already running.",
   "parameters": {
    "type": "object",
    "properties": {
     "workout_type": {
      "type": "string",
      "enum": [
       "running",
       "walking",
       "cycling",
       "swimming",
       "strength",
       "yoga"
      ],
      "description": "The type of workout the user named."
     }
    },
    "required": [
     "workout_type"
    ]
   }
  },
  {
   "name": "end_workout",
   "description": "End the current workout session. Starting a new one is start_workout. Takes no arguments.",
   "parameters": {
    "type": "object",
    "properties": {}
   }
  },
  {
   "name": "find_my_phone",
   "description": "Trigger the phone to ring so you can find it. Takes no arguments.",
   "parameters": {
    "type": "object",
    "properties": {}
   }
  }
 ],
