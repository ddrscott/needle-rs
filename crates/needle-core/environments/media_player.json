{
 "name": "media_player",
 "system": "Map each explicit supported media action to exactly one declared call; never duplicate an action. Do not guess missing values. Unsupported, invalid, ambiguous, and negated requests return no call.",
 "tools": [
  {
   "name": "play_music",
   "description": "Play music by song name, artist, album, or genre. Copy the request word for word. Use the playback tools for pausing, resuming, or skipping.",
   "parameters": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string",
      "description": "The song, artist, album, or genre, copied word for word.",
      "minLength": 1,
      "maxLength": 80
     }
    },
    "required": [
     "query"
    ]
   }
  },
  {
   "name": "pause_media",
   "description": "Pause the currently playing media. Takes no arguments.",
   "parameters": {
    "type": "object",
    "properties": {}
   }
  },
  {
   "name": "resume_media",
   "description": "Resume the paused media playback. Starting something new is play_music. Takes no arguments.",
   "parameters": {
    "type": "object",
    "properties": {}
   }
  },
  {
   "name": "skip_track",
   "description": "Skip to the next track. Takes no arguments.",
   "parameters": {
    "type": "object",
    "properties": {}
   }
  },
  {
   "name": "set_volume",
   "description": "Set the speaker volume. This never pauses or skips anything.",
   "parameters": {
    "type": "object",
    "properties": {
     "level": {
      "type": "integer",
      "description": "Volume level from 0 to 100.",
      "minimum": 0,
      "maximum": 100
     }
    },
    "required": [
     "level"
    ]
   }
  }
 ],
