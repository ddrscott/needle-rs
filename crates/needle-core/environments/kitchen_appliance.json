{
 "name": "kitchen_appliance",
 "system": "Map each explicit supported appliance action to exactly one declared call; never duplicate an action. Do not guess missing values. Unsupported, invalid, ambiguous, and negated requests return no call.",
 "tools": [
  {
   "name": "set_oven",
   "description": "Preheat or set the oven to a temperature in degrees Celsius. Use get_appliance_status to check on it.",
   "parameters": {
    "type": "object",
    "properties": {
     "temperature": {
      "type": "integer",
      "description": "Target temperature in degrees Celsius.",
      "minimum": 50,
      "maximum": 250
     }
    },
    "required": [
     "temperature"
    ]
   }
  },
  {
   "name": "control_coffee_maker",
   "description": "Control the coffee maker. Never use this for the oven or the dishwasher.",
   "parameters": {
    "type": "object",
    "properties": {
     "action": {
      "type": "string",
      "enum": [
       "brew",
       "stop",
       "warm"
      ],
      "description": "brew, stop, or warm."
     }
    },
    "required": [
     "action"
    ]
   }
  },
  {
   "name": "start_dishwasher",
   "description": "Start the dishwasher, optionally on a stated wash cycle.",
   "parameters": {
    "type": "object",
    "properties": {
     "cycle": {
      "type": "string",
      "enum": [
       "eco",
       "heavy",
       "quick"
      ],
      "description": "The wash cycle; include only when stated."
     }
    }
   }
  },
  {
   "name": "set_cooking_timer",
   "description": "Set a named cooking timer.",
   "parameters": {
    "type": "object",
    "properties": {
     "label": {
      "type": "string",
      "description": "Label for the timer, copied from the user.",
      "minLength": 1,
      "maxLength": 40
     },
     "minutes": {
      "type": "integer",
      "description": "Timer duration in minutes.",
      "minimum": 1,
      "maximum": 360
     }
    },
    "required": [
     "label",
     "minutes"
    ]
   }
  },
  {
   "name": "get_appliance_status",
   "description": "Read an appliance's current status. This changes nothing; any request to change settings uses the other tools.",
   "parameters": {
    "type": "object",
    "properties": {
     "appliance": {
      "type": "string",
      "enum": [
       "oven",
       "coffee_maker",
       "dishwasher"
      ],
      "description": "Which appliance to check."
     }
    },
    "required": [
     "appliance"
    ]
   }
  }
 ],
