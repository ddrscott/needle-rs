    }
   }
  ],
  "queries": [
   "take me to the nearest gas station",
   "set the passenger side to 20 degrees",
   "make the driver side 21 degrees",
   "it's freezing, bump everyone to 25",
   "play some jazz on spotify",
   "call mom"
