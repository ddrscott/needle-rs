 },
 {
  "id": "expense",
  "label": "EXPENSES",
  "title": "Expense capture",
  "blurb": "Turn a note or a receipt line into a typed record: amount, currency and category, ready for the ledger.",
  "system": "",
  "tools": [
   {
    "type": "function",
    "function": {
     "name": "log_expense",
     "description": "Record an expense from a receipt or note.",
     "parameters": {
      "type": "object",
      "properties": {
       "amount": {
        "type": "number"
       },
       "currency": {
        "type": "string",
        "enum": [
         "USD",
         "EUR",
         "GBP",
         "JPY"
        ]
       },
       "category": {
        "type": "string",
        "enum": [
         "food",
         "travel",
         "lodging",
         "office",
         "other"
        ]
       },
       "merchant": {
        "type": "string"
       }
      },
      "required": [
       "amount",
       "currency"
      ]
     }
    }
   }
  ],
  "queries": [
   "lunch at Chipotle was 14.50 dollars",
   "Uber to the airport, 38 USD",
   "ramen in Tokyo for 1200 yen",
   "paid 120 euros for the hotel in Berlin",
   "printer paper from Staples, 23.99 dollars",
   "coffee with a client, 6 pounds"
  ]
 }
]