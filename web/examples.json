[
 {
  "id": "game",
  "label": "GAME_NPC",
  "title": "Game NPC",
  "blurb": "A dungeon crawler hero that takes plain-English commands. Games are one of the real-time loops TypeSafe pitches Jev for.",
  "system": "",
  "tools": [
   {
    "type": "function",
    "function": {
     "name": "move",
     "description": "Walk the hero in a direction.",
     "parameters": {
      "type": "object",
      "properties": {
       "direction": {
        "type": "string",
        "enum": [
         "north",
         "south",
         "east",
         "west"
        ]
       },
       "steps": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
       }
      },
      "required": [
       "direction"
      ]
     }
    }
   },
   {
    "type": "function",
    "function": {
     "name": "attack",
     "description": "Attack an enemy with a weapon.",
     "parameters": {
      "type": "object",
      "properties": {
       "target": {
        "type": "string",
        "enum": [
         "goblin",
         "skeleton",
         "dragon"
        ]
       },
       "weapon": {
        "type": "string",
        "enum": [
         "sword",
         "bow",
         "fireball"
        ]
       }
      },
      "required": [
       "target"
      ]
     }
    }
   },
   {
    "type": "function",
    "function": {
     "name": "use_item",
     "description": "Use an item from the pack.",
     "parameters": {
      "type": "object",
      "properties": {
       "item": {
        "type": "string",
        "enum": [
         "health_potion",
         "torch",
         "key",
         "rope"
        ]
       }
      },
      "required": [
       "item"
      ]
     }
    }
   },
   {
    "type": "function",
    "function": {
     "name": "speak",
     "description": "Say a line to a character.",
     "parameters": {
      "type": "object",
      "properties": {
       "line": {
        "type": "string"
       }
      },
      "required": [
       "line"
      ]
     }
    }
   }
  ],
  "queries": [
   "take two steps east",
   "hit the goblin with my sword",
   "drink a health potion, I'm almost dead",
   "light a torch, it's dark in here",
   "shoot the skeleton with an arrow",
   "tell the innkeeper we need a room for the night"
  ]
 },
 {
  "id": "robot",
  "label": "ROBOT_ARM",
  "title": "Robot arm",
  "blurb": "A pick-and-place arm on a factory line. Every command becomes a typed call the controller can check before it moves.",
  "system": "",
  "tools": [
   {
    "type": "function",
    "function": {
     "name": "pick",
     "description": "Pick up an object with the gripper.",
     "parameters": {
      "type": "object",
      "properties": {
       "object": {
        "type": "string",
        "enum": [
         "box",
         "bottle",
         "cup",
         "bolt"
        ]
       },
       "color": {
        "type": "string",
        "enum": [
         "red",
         "green",
         "blue",
         "yellow"
        ]
       }
      },
      "required": [
       "object"
      ]
     }
    }
   },
   {
    "type": "function",
    "function": {
     "name": "drop_in_bin",
     "description": "Release the held object into one of the bins.",
     "parameters": {
      "type": "object",
      "properties": {
       "bin": {
        "type": "string",
        "enum": [
         "left",
         "right",
         "center"
        ]
       }
      },
      "required": [
       "bin"
      ]
     }
    }
   },
   {
    "type": "function",
    "function": {
     "name": "set_speed",
     "description": "Change how fast the arm moves.",
     "parameters": {
      "type": "object",
      "properties": {
       "speed": {
        "type": "string",
        "enum": [
         "slow",
         "normal",
         "fast"
        ]
       }
      },
      "required": [
       "speed"
      ]
     }
    }
   },
   {
    "type": "function",
    "function": {
     "name": "stop",
     "description": "Stop the arm immediately.",
     "parameters": {
      "type": "object",
      "properties": {
       "reason": {
        "type": "string"
       }
      },
      "required": []
     }
    }
   }
  ],
  "queries": [
   "grab the red cup",
   "pick up the blue bottle",
   "drop it in the left bin",
   "slow down a bit",
   "switch to fast mode",
   "stop! someone just walked into the cell"
  ]
 },
 {
